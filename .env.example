# Copia este archivo como ".env" (en la raíz, junto a manage.py) y ajusta los valores.
# NUNCA subas el archivo .env a GitHub.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-50-caracteres-o-mas
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Orígenes permitidos del frontend (separados por comas) ---
# CORS_ORIGINS=https://certificados.tu-dominio.edu.pe
FRONTEND_URL=http://localhost:3000

# --- Base de datos (si DB_NAME no existe se usa SQLite) ---
# DB_NAME=unsch_cert
# DB_USER=unsch
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Producción detrás de nginx con HTTPS ---
# CONFIAR_EN_PROXY=True
# FORZAR_HTTPS=True
# DJANGO_CACHE_EN_BD=True

# --- Correo (si EMAIL_HOST no existe, los correos se imprimen en la consola) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=INDI UNSCH <no-reply@unsch.edu.pe>

# --- Acta de notas ---
# PLAZO_ACTA_DIAS=7
# Pon True cuando todos los cursos usen actas: sin acta firmada no se emiten certificados.
# ACTA_OBLIGATORIA_PARA_CERTIFICADO=False
